#include<stdio.h>
#include<string.h>
int n;
int m;
int a[100001];
long long pre[100001];
void sum(int b[]){
    for(int i = 1; i <= n; i++){
        pre[i] = pre[i-1] + b[i];
    }
    return;
}


int main(){
    int l,r;
    scanf("%d", &n);
    a[0] = 0;
    for(int i=1; i<=n; i++){
        scanf("%d", &a[i]);
    }
    pre[0]=a[0];
    scanf("%d", &m);
    sum(a);
    for(int i = 1; i<=m; i++){
        scanf("%d %d", &l, &r);
        printf("%lld\n", pre[r]-pre[l-1]);
    }
    return 0;
}
